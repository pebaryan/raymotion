cmake_minimum_required(VERSION 3.21)
project(raymotion_cpp_scene LANGUAGES CXX)
if(WIN32)
  set(CMAKE_MT [==[@RMTN_MANIFEST_TOOL@]==])
  set(CMAKE_RC_COMPILER [==[@RMTN_RESOURCE_COMPILER@]==])
  set(CMAKE_MT [==[@RMTN_MANIFEST_TOOL@]==] CACHE FILEPATH "" FORCE)
  set(CMAKE_RC_COMPILER [==[@RMTN_RESOURCE_COMPILER@]==] CACHE FILEPATH "" FORCE)
endif()
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
include([==[@RMTN_SDK@]==])
add_executable(scene entry.cpp)
target_link_libraries(scene PRIVATE rmtn_engine)
set_target_properties(scene PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
  RUNTIME_OUTPUT_DIRECTORY_DEBUG "${CMAKE_BINARY_DIR}/bin"
  RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_BINARY_DIR}/bin"
  RUNTIME_OUTPUT_DIRECTORY_RELWITHDEBINFO "${CMAKE_BINARY_DIR}/bin"
  RUNTIME_OUTPUT_DIRECTORY_MINSIZEREL "${CMAKE_BINARY_DIR}/bin")
