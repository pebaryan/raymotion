set(RMTN_CPP_ROOT [==[@CMAKE_CURRENT_SOURCE_DIR@]==])
set(RMTN_CPP_TARGETS [==[@CMAKE_CURRENT_BINARY_DIR@/cpp-sdk/Targets.cmake]==])
set(RMTN_CPP_COMPILER [==[@CMAKE_CXX_COMPILER@]==])
set(RMTN_CPP_GENERATOR [==[@CMAKE_GENERATOR@]==])
set(RMTN_CPP_MAKE_PROGRAM [==[@CMAKE_MAKE_PROGRAM@]==])
set(RMTN_CPP_PLATFORM [==[@CMAKE_GENERATOR_PLATFORM@]==])
set(RMTN_CPP_TOOLSET [==[@CMAKE_GENERATOR_TOOLSET@]==])
set(RMTN_CPP_CONFIG "$<CONFIG>")
set(CMAKE_MSVC_RUNTIME_LIBRARY [==[@CMAKE_MSVC_RUNTIME_LIBRARY@]==])
set(CMAKE_CXX_FLAGS [==[@CMAKE_CXX_FLAGS@]==])
set(CMAKE_CXX_FLAGS_DEBUG [==[@CMAKE_CXX_FLAGS_DEBUG@]==])
set(CMAKE_CXX_FLAGS_RELEASE [==[@CMAKE_CXX_FLAGS_RELEASE@]==])
set(CMAKE_CXX_FLAGS_RELWITHDEBINFO [==[@CMAKE_CXX_FLAGS_RELWITHDEBINFO@]==])
set(CMAKE_CXX_FLAGS_MINSIZEREL [==[@CMAKE_CXX_FLAGS_MINSIZEREL@]==])
set(CMAKE_CXX_STANDARD_LIBRARIES [==[@CMAKE_CXX_STANDARD_LIBRARIES@]==])
set(CMAKE_EXE_LINKER_FLAGS [==[@CMAKE_EXE_LINKER_FLAGS@]==])
if(MSVC AND EXISTS "${RMTN_CPP_ROOT}/third_party/msvc-sdk-libs/kernel32.lib")
  set(_CMAKE_VS_LINK_EXE "")
  set(_CMAKE_VS_LINK_DLL "")
endif()
set(_compile_options [==[@RMTN_CPP_COMPILE_OPTIONS@]==])
set(_link_options [==[@RMTN_CPP_LINK_OPTIONS@]==])
add_compile_options(${_compile_options})
add_link_options(${_link_options})
@RMTN_CPP_RAYLIB_SETUP@
find_package(Threads REQUIRED)
include("${RMTN_CPP_TARGETS}")
