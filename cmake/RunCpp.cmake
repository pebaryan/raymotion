cmake_minimum_required(VERSION 3.21)
file(READ "${RMTN_REQUEST}" request)
file(REMOVE "${RMTN_REQUEST}")
string(JSON RMTN_SDK GET "${request}" sdk)
# Sdk.cmake contains target commands, so read toolchain information in a project below.
string(JSON RMTN_SOURCE GET "${request}" source)
string(JSON RMTN_ENTRY GET "${request}" entry)
if(NOT RMTN_ENTRY MATCHES "^(::)?[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$")
  message(FATAL_ERROR "--cpp-entry must be a C++ function name")
endif()
if(NOT EXISTS "${RMTN_SOURCE}")
  message(FATAL_ERROR "cannot read C++ composition: ${RMTN_SOURCE}")
endif()
if(RMTN_SOURCE MATCHES "[;\"\n\r]")
  message(FATAL_ERROR "unsupported characters in C++ composition path")
endif()
get_filename_component(sdk_dir "${RMTN_SDK}" DIRECTORY)
string(SHA256 key "${RMTN_SOURCE}|${RMTN_ENTRY}")
string(SUBSTRING "${key}" 0 20 key)
get_filename_component(sdk_root "${sdk_dir}" DIRECTORY)
get_filename_component(build_root "${sdk_root}" DIRECTORY)
get_filename_component(config_name "${sdk_dir}" NAME)
set(work "${build_root}/cpp-cache/${config_name}/${key}")
file(MAKE_DIRECTORY "${work}")
if(WIN32)
  # Keep compiler/linker scratch beside the build (also works on restricted TEMP installs).
  file(MAKE_DIRECTORY "${work}/tmp")
  set(ENV{TMP} "${work}/tmp")
  set(ENV{TEMP} "${work}/tmp")
endif()
file(LOCK "${work}/compile.lock" GUARD PROCESS TIMEOUT 120)
configure_file("${CMAKE_CURRENT_LIST_DIR}/CppEntry.cpp.in" "${work}/entry.cpp" @ONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/CppProject.cmake.in" "${work}/CMakeLists.txt" @ONLY)
string(JSON compiler GET "${request}" compiler)
string(JSON generator GET "${request}" generator)
string(JSON make_program GET "${request}" make_program)
string(JSON config GET "${request}" config)
string(JSON platform GET "${request}" platform)
string(JSON toolset GET "${request}" toolset)
set(extra)
if(platform)
  list(APPEND extra -A "${platform}")
endif()
if(toolset)
  list(APPEND extra -T "${toolset}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}" -B "${work}/build" -G "${generator}"
  "-DCMAKE_CXX_COMPILER=${compiler}" "-DCMAKE_MAKE_PROGRAM=${make_program}"
  "-DCMAKE_BUILD_TYPE=${config}" "-DCMAKE_TRY_COMPILE_CONFIGURATION=${config}"
  -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY ${extra}
  RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "C++ scene configure failed:\n${log}\n${errors}")
endif()
set(config_args)
if(config)
  list(APPEND config_args --config "${config}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/build" ${config_args} --target scene
  RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "C++ scene compilation failed:\n${log}\n${errors}")
endif()
file(LOCK "${work}/compile.lock" RELEASE)
set(args)
string(JSON count LENGTH "${request}" args)
if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON arg GET "${request}" args ${i})
    string(REPLACE ";" "\\;" arg "${arg}")
    list(APPEND args "${arg}")
  endforeach()
endif()
if(WIN32)
  set(suffix .exe)
endif()
execute_process(COMMAND "${work}/build/bin/scene${suffix}" ${args} RESULT_VARIABLE status)
# cmake -P cannot return an arbitrary status on the project's minimum CMake version.
if(NOT status EQUAL 0)
  message(FATAL_ERROR "C++ scene runner failed (exit ${status})")
endif()
